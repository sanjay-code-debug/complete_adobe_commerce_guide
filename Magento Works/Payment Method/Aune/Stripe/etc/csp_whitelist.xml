<?xml version="1.0"?>
<csp_whitelist xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Csp/etc/csp_whitelist.xsd">
    <policies>
        <policy id="script-src">
            <values>
                <value id="stripe-js" type="host">https://js.stripe.com</value>
            </values>
        </policy>
        <policy id="frame-src">
            <values>
                <value id="stripe-frame-1" type="host">https://js.stripe.com</value>
                <value id="stripe-frame-2" type="host">https://*.stripe.com</value>
                <value id="stripe-frame-3" type="host">https://hooks.stripe.com</value>
            </values>
        </policy>
        <policy id="connect-src">
            <values>
                <value id="stripe-api" type="host">https://api.stripe.com</value>
                <value id="stripe-connect" type="host">https://*.stripe.com</value>
            </values>
        </policy>
        <policy id="img-src">
            <values>
                <value id="stripe-img" type="host">https://*.stripe.com</value>
            </values>
        </policy>
        <policy id="font-src">
            <values>
                <value id="stripe-font" type="host">https://*.stripe.com</value>
            </values>
        </policy>
    </policies>
</csp_whitelist>
