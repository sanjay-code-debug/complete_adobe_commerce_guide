<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Api/etc/extension_attributes.xsd">
    <extension_attributes for="Magento\Catalog\Api\Data\ProductInterface">
        <attribute code="is_postpay_available" type="string" />
        <attribute code="is_tabby_available" type="string" />
        <attribute code="is_applepay_enable" type="boolean" />
        <attribute code="is_cardpayment_enble" type="boolean" />
        <attribute code="only_qty_left" type="string" />
        <attribute code="klevu_search_url" type="string" />
        <attribute code="klevu_api_key" type="string" />
        <attribute code="pdp_description" type="string" />
        <attribute code="wp_warning_message" type="string" />
        <attribute code="available_stock" type="string" />
    </extension_attributes>

    <extension_attributes for="Magento\Quote\Api\Data\CartInterface">
        <attribute code="is_postpay_available" type="string" />
        <attribute code="is_tabby_available" type="string" />
        <attribute code="is_applepay_enable" type="boolean" />
        <attribute code="is_cardpayment_enble" type="boolean" />
    </extension_attributes>

    <extension_attributes for="Magento\Quote\Api\Data\CartItemInterface">
        <attribute code="image" type="string" />
        <attribute code="short_description" type="string" />
        <attribute code="salable_qty" type="string" />
        <attribute code="original_price" type="string" />
        <attribute code="custom_product_id" type="int" />
        <attribute code="cart_item_warning_message" type="string" />
        <attribute code="wp_warning_message" type="string" />
        <attribute code="only_qty_left" type="string" />
    </extension_attributes>

    <extension_attributes for="Magento\Sales\Api\Data\OrderItemInterface">
        <attribute code="image" type="string" />
        <attribute code="short_description" type="string" />
        <attribute code="return_possible_date" type="string" />
    </extension_attributes>

    <extension_attributes for="Magento\Sales\Api\Data\OrderInterface">
        <attribute code="status_label" type="string" />
    </extension_attributes>

    <extension_attributes for="Magento\Quote\Api\Data\PaymentInterface">
        <attribute code="app_version" type="string" />
        <attribute code="iphone_model_type" type="string" />
    </extension_attributes>

    <extension_attributes for="Magento\Quote\Api\Data\ShippingMethodInterface">
        <attribute code="server_time" type="string" />
        <attribute code="available_dates" type="array" />
    </extension_attributes>

    <!--    instance coupon extension attribute-->
    <extension_attributes for="Magento\Quote\Api\Data\TotalsInterface">
        <attribute code="instant_coupon_applied" type="boolean" />
    </extension_attributes>

    <extension_attributes for="Magento\Checkout\Api\Data\ShippingInformationInterface">
        <attribute code="payment_method_for_app" type="boolean"/>
    </extension_attributes>

    <extension_attributes for="Magento\Checkout\Api\Data\PaymentDetailsInterface">
        <attribute code="is_postpay_enable" type="boolean" />
        <attribute code="is_tabby_enable" type="boolean" />
        <attribute code="is_applepay_enable" type="boolean" />
        <attribute code="is_cardpayment_enble" type="boolean" />
    </extension_attributes>

</config>
