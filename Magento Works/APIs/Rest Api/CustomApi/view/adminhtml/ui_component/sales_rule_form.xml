<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <fieldset name="rule_information" sortOrder="10">
        <field name="rule_is_for" formElement="select">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">rule_is_for</item>
                </item>
            </argument>
            <settings>
                <dataType>number</dataType>
                <label translate="true">Rule Applied For</label>
                <visible>true</visible>
                <dataScope>rule_is_for</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Codilar\CustomApi\Model\Source\CouponSource"/>
                    </settings>
                </select>
            </formElements>
        </field>
    </fieldset>
</form>
